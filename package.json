    "echarts": "^6.0.0",
    "echarts-for-react": "^3.0.5",
    "firebase": "^12.7.0",
    "jszip": "^3.10.1",
    "lodash": "^4.17.21",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.11.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@google/design.md": "^0.1.1",
