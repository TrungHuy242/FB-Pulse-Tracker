@startuml FB_Pulse_Tracker_UseCase
!theme plain

/'
 ============================================================================
 * FB Pulse Tracker - Use Case Diagram (Academic Style)
 * Based on actual implementation analysis
 * Black & White - Clean UML notation
 ============================================================================
'/

skinparam {
    backgroundColor #FFFFFF
    shadowing false
    defaultFontName Arial
    defaultFontSize 11
    actorBorderColor #000000
    actorBackgroundColor #FFFFFF
    usecaseBorderColor #000000
    usecaseBackgroundColor #FFFFFF
    usecaseBorderThickness 1
    actorStyle filled
    roundcorner 0
    linethickness 1
}

/' ========================================================================
 * ACTORS
 * ======================================================================== '/

left to right direction

actor "Admin" as admin
actor "Nhân viên Marketing" as viewer

/' ========================================================================
 * SYSTEM BOUNDARY
 * ======================================================================== '/

rectangle "FB Pulse Tracker" {

    /' ----------------------------------------------------------------
     * AUTHENTICATION
     * ---------------------------------------------------------------- '/
    usecase "UC01. Đăng nhập" as UC_LOGIN
    usecase "UC02. Đăng xuất" as UC_LOGOUT
    usecase "UC03. Xác thực quyền truy cập" as UC_AUTH

    /' ----------------------------------------------------------------
     * DASHBOARD
     * ---------------------------------------------------------------- '/
    usecase "UC04. Xem Dashboard" as UC_DASHBOARD
    usecase "UC05. Xem thống kê tổng quan" as UC_STATS
    usecase "UC06. Lọc dữ liệu theo thời gian" as UC_FILTER_DATE
    usecase "UC07. Lọc dữ liệu theo tài khoản" as UC_FILTER_ACCOUNT
    usecase "UC08. Xem biểu đồ tương tác" as UC_ENGAGEMENT_CHART

    /' ----------------------------------------------------------------
     * IMPORT MANAGEMENT
     * ---------------------------------------------------------------- '/
    usecase "UC09. Nhập dữ liệu Facebook ZIP" as UC_IMPORT
    usecase "UC10. Xem danh sách nhập liệu" as UC_VIEW_IMPORTS
    usecase "UC11. Xóa nhập liệu" as UC_DELETE_IMPORT
    usecase "UC12. Xóa tất cả nhập liệu" as UC_DELETE_ALL

    /' ----------------------------------------------------------------
     * COMMENT MANAGEMENT
     * ---------------------------------------------------------------- '/
    usecase "UC13. Xem bình luận" as UC_VIEW_COMMENTS
    usecase "UC14. Tìm kiếm bình luận" as UC_SEARCH
    usecase "UC15. Lọc bình luận" as UC_FILTER_COMMENT
    usecase "UC16. Xem chi tiết bình luận" as UC_COMMENT_DETAIL

    /' ----------------------------------------------------------------
     * ANALYTICS
     * ---------------------------------------------------------------- '/
    usecase "UC17. Xem phân tích" as UC_ANALYTICS
    usecase "UC18. Xem biểu đồ xu hướng" as UC_TIMELINE
    usecase "UC19. Phân tích cảm xúc" as UC_SENTIMENT

    /' ----------------------------------------------------------------
     * EXPORT
     * ---------------------------------------------------------------- '/
    usecase "UC20. Xuất CSV" as UC_EXPORT_CSV
    usecase "UC21. Xuất JSON" as UC_EXPORT_JSON
    usecase "UC22. Xuất Excel" as UC_EXPORT_XLSX
    usecase "UC23. In báo cáo" as UC_PRINT

    /' ----------------------------------------------------------------
     * SEEDING MANAGEMENT
     * ---------------------------------------------------------------- '/
    usecase "UC24. Xem Dashboard Seeding" as UC_SEEDING_DASH
    usecase "UC25. Xem danh sách bài viết" as UC_SEEDING_LIST
    usecase "UC26. Tạo chiến dịch Seeding" as UC_CREATE_CAMPAIGN
    usecase "UC27. Tạo 4 bài viết hàng ngày" as UC_DAILY_POSTS
    usecase "UC28. Quản lý nhóm Facebook" as UC_MANAGE_GROUPS
    usecase "UC29. Xem lịch sử bài viết" as UC_POST_HISTORY
    usecase "UC30. Sử dụng công cụ Redirect" as UC_REDIRECT_TOOL
    usecase "UC31. Tạo nội dung Redirect" as UC_GENERATE_REDIRECT
    usecase "UC32. Xóa bài viết Seeding" as UC_DELETE_POST

    /' ----------------------------------------------------------------
     * ADMIN MANAGEMENT
     * ---------------------------------------------------------------- '/
    usecase "UC33. Xem danh sách người dùng" as UC_VIEW_USERS
    usecase "UC34. Tạo tài khoản người dùng" as UC_CREATE_USER
    usecase "UC35. Sửa tài khoản người dùng" as UC_EDIT_USER
    usecase "UC36. Xóa tài khoản người dùng" as UC_DELETE_USER
    usecase "UC37. Thay đổi vai trò người dùng" as UC_CHANGE_ROLE

    /' ----------------------------------------------------------------
     * SETTINGS
     * ---------------------------------------------------------------- '/
    usecase "UC38. Thay đổi giao diện" as UC_THEME
    usecase "UC39. Xem thông tin cá nhân" as UC_PROFILE
}

/' ========================================================================
 * ASSOCIATIONS - ADMIN
 * ======================================================================== '/

admin --> UC_LOGIN
admin --> UC_LOGOUT
admin --> UC_DASHBOARD
admin --> UC_STATS
admin --> UC_FILTER_DATE
admin --> UC_FILTER_ACCOUNT
admin --> UC_ENGAGEMENT_CHART
admin --> UC_IMPORT
admin --> UC_VIEW_IMPORTS
admin --> UC_DELETE_IMPORT
admin --> UC_DELETE_ALL
admin --> UC_VIEW_COMMENTS
admin --> UC_SEARCH
admin --> UC_FILTER_COMMENT
admin --> UC_COMMENT_DETAIL
admin --> UC_ANALYTICS
admin --> UC_TIMELINE
admin --> UC_SENTIMENT
admin --> UC_EXPORT_CSV
admin --> UC_EXPORT_JSON
admin --> UC_EXPORT_XLSX
admin --> UC_PRINT
admin --> UC_SEEDING_DASH
admin --> UC_SEEDING_LIST
admin --> UC_CREATE_CAMPAIGN
admin --> UC_DAILY_POSTS
admin --> UC_MANAGE_GROUPS
admin --> UC_POST_HISTORY
admin --> UC_REDIRECT_TOOL
admin --> UC_GENERATE_REDIRECT
admin --> UC_DELETE_POST
admin --> UC_VIEW_USERS
admin --> UC_CREATE_USER
admin --> UC_EDIT_USER
admin --> UC_DELETE_USER
admin --> UC_CHANGE_ROLE
admin --> UC_THEME
admin --> UC_PROFILE

/' ========================================================================
 * ASSOCIATIONS - VIEWER / NHAN VIEN MARKETING
 * ======================================================================== '/

viewer --> UC_LOGIN
viewer --> UC_LOGOUT
viewer --> UC_DASHBOARD
viewer --> UC_STATS
viewer --> UC_FILTER_DATE
viewer --> UC_FILTER_ACCOUNT
viewer --> UC_ENGAGEMENT_CHART
viewer --> UC_VIEW_IMPORTS
viewer --> UC_VIEW_COMMENTS
viewer --> UC_SEARCH
viewer --> UC_FILTER_COMMENT
viewer --> UC_COMMENT_DETAIL
viewer --> UC_ANALYTICS
viewer --> UC_TIMELINE
viewer --> UC_SENTIMENT
viewer --> UC_EXPORT_CSV
viewer --> UC_EXPORT_JSON
viewer --> UC_EXPORT_XLSX
viewer --> UC_PRINT
viewer --> UC_SEEDING_DASH
viewer --> UC_SEEDING_LIST
viewer --> UC_CREATE_CAMPAIGN
viewer --> UC_DAILY_POSTS
viewer --> UC_MANAGE_GROUPS
viewer --> UC_POST_HISTORY
viewer --> UC_REDIRECT_TOOL
viewer --> UC_GENERATE_REDIRECT
viewer --> UC_DELETE_POST
viewer --> UC_THEME
viewer --> UC_PROFILE

/' ========================================================================
 * INCLUDE RELATIONSHIPS (Actual Workflow)
 * ======================================================================== '/

UC_LOGIN ..> UC_AUTH : <<include>>

/' ========================================================================
 * GENERALIZATION
 * ======================================================================== '/

admin -|> viewer : <<extends>>

/' ========================================================================
 * TITLE
 * ======================================================================== /

title FB Pulse Tracker - Use Case Diagram\n(System Analysis Based on Implementation)

@enduml
