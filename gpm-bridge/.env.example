# Cấu hình kết nối GPM Login API
GPM_API_URL=http://127.0.0.1:19995

# Đường dẫn tới file credentials Firebase Service Account (JSON)
# Bạn tải file này từ Firebase Console -> Project Settings -> Service Accounts
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Thời gian trễ tối thiểu và tối đa (giây) giữa các thao tác (Like, Comment, Share)
# Để mô phỏng hành vi giống con người thật, tránh checkpoint tài khoản
MIN_DELAY_SECONDS=5
MAX_DELAY_SECONDS=20
