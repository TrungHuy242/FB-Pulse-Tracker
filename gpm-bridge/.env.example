# Cau hinh ket noi GPM Login API.
# Port mac dinh theo tai lieu GPM Login local API: 9495.
# Neu GPM bao port khac trong file http.port, doi lai bien nay.
GPM_API_URL=http://127.0.0.1:9495

# Duong dan den GPMLoginGlobal.exe de bridge co the tu mo GPM neu API chua san sang.
# Neu bo trong, bridge se tu do cac duong dan pho bien trong AppData / Program Files.
GPM_EXECUTABLE_PATH=C:\Users\Acer\AppData\Local\Programs\GPMLoginGlobal\GPMLoginGlobal.exe

# File chua port thuc te neu GPM doi port khoi dong. Bo trong de bridge tu do.
GPM_HTTP_PORT_FILE=

# Bat/tat auto-start GPM khi bridge gap API chua san sang.
GPM_AUTO_START=true
GPM_AUTO_START_ON_BRIDGE_START=true
GPM_STARTUP_TIMEOUT_MS=45000
GPM_STARTUP_POLL_INTERVAL_MS=1500
GPM_STARTUP_ARGS=

# Duong dan toi file credentials Firebase Service Account (JSON).
# Tai file nay tu Firebase Console -> Project Settings -> Service Accounts.
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Thoi gian tre toi thieu va toi da (giay) giua cac thao tac.
MIN_DELAY_SECONDS=5
MAX_DELAY_SECONDS=20

# Port cua HTTP API Server. Web app goi qua day de tranh CORS voi GPM API.
# Can khop voi VITE_GPM_BRIDGE_URL trong file .env cua web app.
API_SERVER_PORT=3001

# Tuy chon CORS cho bridge. De "*" khi chay local dev.
BRIDGE_CORS_ORIGIN=*
