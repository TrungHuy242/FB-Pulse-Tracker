# ============================================================
# FB Pulse Tracker — Environment Variables
# ============================================================
# Sao chép file này thành .env.local và điền giá trị thực.
# KHÔNG commit .env.local lên Git.
# ============================================================

# ── Firebase Configuration ────────────────────────────────
# Lấy từ: Firebase Console > Project Settings > Your apps > Config
VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef123456

# ── Sentry Error Monitoring (tùy chọn) ────────────────────
# Lấy từ: sentry.io > Settings > Projects > Client Keys (DSN)
# Để trống nếu không dùng Sentry — ứng dụng vẫn hoạt động bình thường.
VITE_SENTRY_DSN=
