# ============================================================
# FB Pulse Tracker — Environment Variables
# ============================================================
# Sao chép file này thành .env.local và điền giá trị thực.
# KHÔNG commit .env.local lên Git.
# ============================================================

# ── Firebase Configuration ────────────────────────────────
# Lấy từ: Firebase Console > Project Settings > Your apps > Config
VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef123456

# ── Gemini AI (tùy chọn — client-side, CHỈ dùng cho dev local) ──
# ⚠️  CẢNH BÁO BẢO MẬT: Mọi biến VITE_* đều được BUNDLE vào JavaScript
# client-side và CÔNG KHAI với bất kỳ ai inspect mã nguồn browser.
# KHÔNG SET key này trên môi trường production!
#
# Trên production: AI features dùng Firebase Cloud Functions (GEMINI_API_KEY
# được lưu server-side qua `firebase functions:secrets:set GEMINI_API_KEY`).
#
# Chỉ set biến này nếu:
#   - Bạn đang dev local và muốn test AI features nhanh
#   - Key được giới hạn quota thấp (dev-only key)
#   - KHÔNG phải production key
VITE_GEMINI_API_KEY=
VITE_GEMINI_MODEL=gemini-2.0-flash
