rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────

    /** Người dùng đã đăng nhập Firebase Auth */
    function isAuthenticated() {
      return request.auth != null;
    }

    /** Kiểm tra user hiện tại có trong whitelist allowedAccounts/{uid}. */
    function isAllowedUser() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/allowedAccounts/$(request.auth.uid));
    }

    /**
     * Kiểm tra user có role admin (role == 1) không.
     * Đọc document allowedAccounts theo UID để lấy role field.
     * Chỉ gọi khi cần kiểm tra write quyền — tránh gọi cho read thường xuyên.
     */
    function isAdmin() {
      return isAllowedUser() &&
        get(/databases/$(database)/documents/allowedAccounts/$(request.auth.uid)).data.role == 1;
    }

    // ── Validation helpers ────────────────────────────────────────────────────

    /** Kiểm tra dữ liệu import khi tạo mới hợp lệ */
    function isValidImportCreate() {
      let d = request.resource.data;
      return d.keys().hasAll(["totalFiles", "status", "importedAt"])
          && d.totalFiles is int
          && d.totalFiles >= 0
          && d.status == "processing";
    }

    /** Kiểm tra dữ liệu import khi finalize hợp lệ */
    function isValidImportUpdate() {
      let d = request.resource.data;
      return d.keys().hasAll(["accountName", "commentsCount", "reactionsCount", "status"])
          && d.accountName is string
          && d.accountName.size() > 0
          && d.commentsCount is int
          && d.commentsCount >= 0
          && d.reactionsCount is int
          && d.reactionsCount >= 0
          && (d.status == "processing" || d.status == "completed");
    }

    /** Kiểm tra dữ liệu allowedAccount hợp lệ */
    function isValidAccountData() {
      let d = request.resource.data;
      return d.keys().hasAll(["email", "displayName", "role"])
          && d.email is string
          && d.email.size() > 0
          && d.displayName is string
          && d.role in [0, 1];
    }

    // ── allowedAccounts ───────────────────────────────────────────────────────
    // Quản lý danh sách tài khoản được phép truy cập ứng dụng.
    match /allowedAccounts/{accountId} {
      // User chỉ được đọc document của chính mình; admin được đọc/list toàn bộ whitelist.
      allow get: if isAuthenticated() && (accountId == request.auth.uid || isAdmin());
      allow list: if isAdmin();

      // Tạo mới: chỉ admin, và không được tự tạo/chỉnh quyền document của chính mình từ client.
      allow create: if isAdmin()
                    && accountId != request.auth.uid
                    && isValidAccountData();

      // Cập nhật: admin được sửa user; nếu sửa chính mình thì role phải giữ nguyên.
      allow update: if isAdmin()
                    && isValidAccountData()
                    && (accountId != request.auth.uid || request.resource.data.role == resource.data.role);

      // Xóa: chỉ admin, không được tự xóa chính mình
      allow delete: if isAdmin() && accountId != request.auth.uid;
    }

    // ── imports ───────────────────────────────────────────────────────────────
    // Dữ liệu import Facebook của người dùng.
    // Read-only role: xem dữ liệu, không thể import hay xóa.
    // Admin role: toàn quyền tạo, cập nhật, xóa.
    match /imports/{importId} {
      // Đọc: chỉ user trong whitelist (cả read-only lẫn admin)
      allow read: if isAllowedUser();

      // Tạo mới import (bắt đầu quá trình upload): chỉ admin
      allow create: if isAdmin() && isValidImportCreate();

      // Cập nhật import (finalize sau khi upload xong): chỉ admin
      allow update: if isAdmin() && isValidImportUpdate();

      // Xóa: chỉ admin
      allow delete: if isAdmin();

      // ── imports/{importId}/commentChunks ─────────────────────────────────
      // Sub-collection chứa bình luận theo từng chunk (tối đa 700 items/chunk).
      match /commentChunks/{chunkId} {
        allow read: if isAllowedUser();
        allow create: if isAdmin();
        allow update: if isAdmin();
        allow delete: if isAdmin();
      }

      // ── imports/{importId}/reactionChunks ────────────────────────────────
      // Sub-collection chứa cảm xúc theo từng chunk (tối đa 2000 items/chunk).
      match /reactionChunks/{chunkId} {
        allow read: if isAllowedUser();
        allow create: if isAdmin();
        allow update: if isAdmin();
        allow delete: if isAdmin();
      }
    }

    // ── Seeding Manager ───────────────────────────────────────────────────────
    // Bộ 4 collections cho module Seeding Manager (GPM Excel bridge).
    // Read: isAllowedUser — Write: isAdmin + schema validation.

    function isValidSeedingProfile() {
      let d = request.resource.data;
      return d.keys().hasAll(["profileId", "profileName", "status"])
          && d.profileId is string && d.profileId.size() > 0
          && d.profileName is string && d.profileName.size() > 0
          && d.status in ["active", "inactive", "banned"];
    }

    function isValidSeedingCampaign() {
      let d = request.resource.data;
      return d.keys().hasAll(["name", "status"])
          && d.name is string && d.name.size() > 0
          && d.status in ["draft", "active", "paused", "completed", "scheduled"]
          && (d.status != "scheduled" || d.scheduledAt is timestamp);
    }

    function isValidSeedingTask() {
      let d = request.resource.data;
      return d.keys().hasAll(["campaignId", "profileId", "action", "targetUrl"])
          && d.campaignId is string && d.campaignId.size() > 0
          && d.profileId is string && d.profileId.size() > 0
          && d.action in ["like", "comment", "share"]
          && d.targetUrl is string && d.targetUrl.size() > 0;
    }

    function isValidSeedingComment() {
      let d = request.resource.data;
      return d.keys().hasAll(["text", "tags"])
          && d.text is string && d.text.size() > 0
          && d.tags is list;
    }

    match /seedingProfiles/{id} {
      allow read: if isAllowedUser();
      allow create: if isAdmin() && isValidSeedingProfile();
      allow update: if isAdmin() && isValidSeedingProfile();
      allow delete: if isAdmin();
    }

    match /seedingCampaigns/{id} {
      allow read: if isAllowedUser();
      allow create: if isAdmin() && isValidSeedingCampaign();
      allow update: if isAdmin() && isValidSeedingCampaign();
      allow delete: if isAdmin();
    }

    match /seedingTasks/{id} {
      allow read: if isAllowedUser();
      allow create: if isAdmin() && isValidSeedingTask();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /seedingComments/{id} {
      allow read: if isAllowedUser();
      allow create: if isAdmin() && isValidSeedingComment();
      allow update: if isAdmin() && isValidSeedingComment();
      allow delete: if isAdmin();
    }

    // ── Mặc định: từ chối tất cả ─────────────────────────────────────────────
    // Bất kỳ collection hoặc sub-collection chưa được khai báo ở trên
    // đều bị từ chối hoàn toàn — bảo vệ khỏi dữ liệu ngẫu nhiên.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
